# Variables de entorno - BACKEND
# Copia este archivo a .env y configura con valores reales

# Seguridad
JWT_SECRET=CAMBIAR-POR-UNA-CLAVE-MUY-LARGA-Y-SEGURA-DE-AL-MENOS-32-CARACTERES
JWT_EXPIRY=24h

# Base de datos
DB_PATH=./data/facturas.db
AUDIT_DB_PATH=./data/audit.db

# Servidor
NODE_ENV=production
PORT=5000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=https://mari-pepa.com,https://www.mari-pepa.com

# Logs
LOG_LEVEL=info
LOG_PATH=./logs

# Chatbot AI - Groq (Llama 3.3 70B - GRATUITO)
# Obtener API key en: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXX

# Google AI (opcional, legacy)
# GOOGLE_AI_API_KEY=tu_api_key_aqui

# Email Service (SMTP)
# Para Gmail: smtp.gmail.com (puerto 587) + App Password
# Para Outlook: smtp-mail.outlook.com (puerto 587)
# Para SendGrid: smtp.sendgrid.net (puerto 587) + API Key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@granjamaripepa.com
SMTP_PASS=TU_PASSWORD_AQUI
SMTP_FROM_NAME=Granja Mari Pepa
SMTP_FROM_EMAIL=noreply@granjamaripepa.com
