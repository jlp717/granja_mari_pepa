# Variables de entorno - BACKEND
# Copia este archivo a .env y configura con valores reales

# Seguridad
JWT_SECRET=CAMBIAR-POR-UNA-CLAVE-MUY-LARGA-Y-SEGURA-DE-AL-MENOS-32-CARACTERES
JWT_EXPIRY=24h

# Base de datos
DB_PATH=./data/facturas.db
AUDIT_DB_PATH=./data/audit.db

# Servidor
NODE_ENV=production
PORT=5000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=https://mari-pepa.com,https://www.mari-pepa.com

# Logs
LOG_LEVEL=info
LOG_PATH=./logs

# Chatbot AI - Google Gemini Flash (GRATUITO)
# Obtener API key en: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=TU_API_KEY_AQUI
