# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# DATABASE - IBM i (AS/400)
# ============================================
DB_ODBC_DSN=YOUR_DSN_NAME
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD

# ============================================
# JWT SECRETS (Generate secure random strings)
# ============================================
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING

# ============================================
# EMAIL - SMTP Configuration
# ============================================
# IMPORTANT: Use the real MX server, NOT the Cloudflare-proxied domain
# To find your real MX server: dig MX your-domain.com +short
# Then verify port 465 works: nc -zv your-mx-server.com 465
SMTP_HOST=_dc-mx.bef93564e202.mari-pepa.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mari-pepa.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=noreply@mari-pepa.com

# ============================================
# FRONTEND URL (for password reset links)
# ============================================
FRONTEND_URL=https://mari-pepa.com

# ============================================
# SECURITY
# ============================================
NODE_ENV=production
