# Frontend Production Environment Template
# =========================================
# Copiar este archivo a .env.production.local en el servidor

# API Backend URL (a través de Nginx proxy)
NEXT_PUBLIC_API_URL=https://mari-pepa.com/api

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=Mari Pepa

# API interna para el renderizado en el servidor (sin pasar por Nginx)
BACKEND_INTERNAL_URL=http://127.0.0.1:5000

# Panel interno: red de empresa/VPN
# Prefijos adicionales permitidos (VPN corporativa), separados por comas
ADMIN_ALLOWED_CIDRS=
ADMIN_TRUST_LOOPBACK=0

# Entorno
NODE_ENV=production

# Deshabilitar telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1
