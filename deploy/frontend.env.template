# Frontend Production Environment Template
# =========================================
# Copiar este archivo a .env.production.local en el servidor

# API Backend URL (a través de Nginx proxy)
NEXT_PUBLIC_API_URL=https://mari-pepa.com/api

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=Granja Mari Pepa

# Entorno
NODE_ENV=production

# Deshabilitar telemetría de Next.js
NEXT_TELEMETRY_DISABLED=1
