# ============================================
# TEMPLATE DE VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Reemplazar TODOS los valores marcados con [CAMBIAR]
# 3. NUNCA subir el .env real a Git
#
# ============================================

# ============================================
# SEGURIDAD JWT (OBLIGATORIO)
# ============================================
# Generar claves seguras con: openssl rand -base64 64
JWT_ACCESS_SECRET=[CAMBIAR_clave_de_64_caracteres_aleatorios]
JWT_REFRESH_SECRET=[CAMBIAR_otra_clave_diferente_de_64_caracteres]
JWT_EXPIRY=24h
COOKIE_SECRET=[CAMBIAR_clave_32_caracteres]

# ============================================
# BASE DE DATOS ODBC (OBLIGATORIO)
# ============================================
# Cadena de conexión al IBM i/AS400
ODBC_CONNECTION_STRING=DSN=[NOMBRE_DSN];UID=[USUARIO];PWD=[PASSWORD]

# ============================================
# SERVIDOR
# ============================================
NODE_ENV=production
PORT=5000
HOST=127.0.0.1

# ============================================
# CORS - Dominios permitidos
# ============================================
CORS_ORIGIN=https://mari-pepa.com,https://www.mari-pepa.com

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info
LOG_PATH=/var/log/mari-pepa

# ============================================
# EMAIL SMTP (Para recuperación de contraseña)
# ============================================
# Opciones comunes:
# - Gmail: smtp.gmail.com:587 (requiere App Password)
# - SendGrid: smtp.sendgrid.net:587
# - Amazon SES: email-smtp.eu-west-1.amazonaws.com:587
SMTP_HOST=[CAMBIAR_servidor_smtp]
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=[CAMBIAR_usuario]
SMTP_PASS=[CAMBIAR_password]
SMTP_FROM_NAME=Granja Mari Pepa
SMTP_FROM_EMAIL=noreply@mari-pepa.com

# ============================================
# CHATBOT AI (Opcional)
# ============================================
# API Key de Groq: https://console.groq.com/keys
GROQ_API_KEY=[CAMBIAR_si_usas_chatbot]

# ============================================
# MONITOREO (Opcional)
# ============================================
# Slack webhook para alertas
SLACK_WEBHOOK=
# Email para alertas críticas
EMAIL_ALERT=

# ============================================
# SEGURIDAD AVANZADA (Opcional)
# ============================================
# Máximo intentos de login antes de bloqueo
MAX_LOGIN_ATTEMPTS=5
# Tiempo de bloqueo en minutos
LOGIN_LOCKOUT_MINUTES=15
