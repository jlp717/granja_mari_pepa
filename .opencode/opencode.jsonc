{
  "$schema": "https://opencode.ai/config.json",

  // Override del proyecto sobre la config global ~/.config/opencode/opencode.jsonc
  "model": "openai/gpt-5.4",
  "default_agent": "developer",

  // MCPs activos para este proyecto (heredan definicion de la config global)
  "mcp": {
    "context7":            { "enabled": true },
    "playwright":          { "enabled": true },
    "filesystem":          { "enabled": true },
    "git":                 { "enabled": true },
    "memory":              { "enabled": true },

    // Activos globalmente pero no necesarios aqui
    "github":              { "enabled": false },
    "sequential-thinking": { "enabled": false },
    "ddg-search":          { "enabled": false },
    "fetch":               { "enabled": false },
    "firecrawl":           { "enabled": false }
  }
}
