// granja_mari_pepa — Next.js + Express + PostgreSQL
// Override del proyecto sobre la config global ~/.config/opencode/opencode.jsonc
{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.5",
  "default_agent": "developer",

  // ATENCION: dejar timeout corto para que un MCP roto no cuelgue la TUI.
  // Antes habia mcp_timeout: 3600000 (1 HORA) — eso era la causa del "Loading plugins..." eterno.
  "experimental": {
    "mcp_timeout": 30000
  },

  // Activacion de MCPs para este proyecto. Las definiciones (type/command) vienen de la global.
  "mcp": {
    // Compartidos (siempre on en ambos proyectos)
    "context7":            { "enabled": true },
    "sequential-thinking": { "enabled": true },
    "memory":              { "enabled": true },
    "filesystem":          { "enabled": true },
    "ddg-search":          { "enabled": true },
    "git":                 { "enabled": true },
    "github":              { "enabled": true },
    "firecrawl":           { "enabled": true },

    // Especificos web Next.js
    "playwright":          { "enabled": true },
    "chrome-devtools":     { "enabled": true },

    // Sin credencial -> off (se activan cuando POSTGRES_CONNECTION_STRING / VERCEL_TOKEN / SENTRY_AUTH_TOKEN existan)
    "postgres":            { "enabled": false },
    "vercel":              { "enabled": false },
    "sentry":              { "enabled": false },

    // Paquetes npm sin verificar — off por defecto, activar si se confirma que existen
    "mcp-seo":             { "enabled": false },
    "web-quality-mcp":     { "enabled": false },
    "guardvibe":           { "enabled": false },

    // No relevantes para este proyecto
    "fetch":               { "enabled": false },
    "dart-flutter-mcp":    { "enabled": false },
    "pub-mcp":             { "enabled": false },
    "iflow-flutter":       { "enabled": false },
    "ibm-db2-mcp":         { "enabled": false }
  }
}
