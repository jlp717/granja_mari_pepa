{
  "$schema": "https://opencode.ai/swarm/config.json",
  "version": "1.0",
  "agents": {
    "coder": {
      "model": "claude-sonnet-4-6",
      "provider": "anthropic",
      "skills": ["impeccable", "polish", "optimize"]
    },
    "designer": {
      "model": "claude-sonnet-4-6", 
      "provider": "anthropic",
      "skills": ["impeccable", "colorize", "typeset", "shape", "layout", "bolder", "delight"]
    },
    "critic": {
      "model": "claude-sonnet-4-6",
      "provider": "anthropic",
      "skills": ["audit", "critique", "distill"]
    },
    "fixer": {
      "model": "nvidia/deepseek-v4-pro",
      "provider": "nvidia",
      "skills": ["optimize", "adapt", "polish"]
    },
    "codegen": {
      "model": "openrouter/qwen3-coder",
      "provider": "openrouter",
      "skills": ["animate", "tailwind", "gsap"]
    }
  },
  "mcp": {
    "enabled": ["playwright", "pagecast", "mcp-seo", "websearch"]
  }
}