{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "node frontend/node_modules/eslint/bin/eslint.js --fix --max-warnings 0",
      "node frontend/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
    ],
    "frontend/**/*.{css,scss}": [
      "node frontend/node_modules/prettier/bin/prettier.cjs --write"
    ],
    "frontend/**/*.{json,md}": [
      "node frontend/node_modules/prettier/bin/prettier.cjs --write"
    ]
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
